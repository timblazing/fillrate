{
  "components": {
    "schemas": {
      "Behavior": {
        "properties": {
          "availability": {
            "default": "implemented",
            "enum": [
              "implemented",
              "planned",
              "unsupported"
            ],
            "title": "Availability",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "fixture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fixture"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "provided_by": {
            "enum": [
              "native",
              "preprocessing",
              "workaround",
              "validation"
            ],
            "title": "Provided By",
            "type": "string"
          },
          "restrictions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Restrictions",
            "type": "array"
          }
        },
        "required": [
          "id",
          "provided_by",
          "description",
          "fixture"
        ],
        "title": "Behavior",
        "type": "object"
      },
      "Capabilities": {
        "properties": {
          "adapter_version": {
            "default": "pyvrp-loads/1",
            "title": "Adapter Version",
            "type": "string"
          },
          "behaviors": {
            "items": {
              "$ref": "#/components/schemas/Behavior"
            },
            "title": "Behaviors",
            "type": "array"
          },
          "defaults": {
            "$ref": "#/components/schemas/Defaults"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "platform": {
            "title": "Platform",
            "type": "string"
          },
          "python": {
            "title": "Python",
            "type": "string"
          },
          "schema_version": {
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "travel_modes": {
            "items": {
              "type": "string"
            },
            "title": "Travel Modes",
            "type": "array"
          },
          "units": {
            "$ref": "#/components/schemas/Units"
          },
          "versions": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Versions",
            "type": "object"
          }
        },
        "required": [
          "python",
          "platform",
          "versions",
          "travel_modes",
          "behaviors",
          "limits",
          "defaults",
          "units"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "ContractBundle": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "$ref": "#/components/schemas/WorkerEvent"
          },
          "manifest": {
            "$ref": "#/components/schemas/StageManifest"
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          }
        },
        "required": [
          "manifest",
          "event",
          "snapshot"
        ],
        "title": "ContractBundle",
        "type": "object"
      },
      "Defaults": {
        "properties": {
          "circuity": {
            "default": 1.2,
            "title": "Circuity",
            "type": "number"
          },
          "max_cluster_diameter_m": {
            "default": 804672,
            "title": "Max Cluster Diameter M",
            "type": "integer"
          },
          "max_leg_m": {
            "default": 804672,
            "title": "Max Leg M",
            "type": "integer"
          },
          "trailer_capacity": {
            "default": 5300,
            "title": "Trailer Capacity",
            "type": "integer"
          }
        },
        "title": "Defaults",
        "type": "object"
      },
      "JsonValue": {},
      "Lease": {
        "additionalProperties": false,
        "properties": {
          "attempt": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "title": "Attempt",
            "type": "integer"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "lease_token": {
            "format": "uuid",
            "title": "Lease Token",
            "type": "string"
          },
          "worker_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "worker_id",
          "lease_token",
          "attempt"
        ],
        "title": "Lease",
        "type": "object"
      },
      "Limits": {
        "properties": {
          "max_orders": {
            "default": 5000,
            "title": "Max Orders",
            "type": "integer"
          },
          "max_stops_per_solve": {
            "default": 500,
            "title": "Max Stops Per Solve",
            "type": "integer"
          },
          "run_wall_limit_seconds": {
            "default": 600,
            "title": "Run Wall Limit Seconds",
            "type": "integer"
          },
          "solve_attempt_limit_seconds": {
            "default": 300,
            "title": "Solve Attempt Limit Seconds",
            "type": "integer"
          }
        },
        "title": "Limits",
        "type": "object"
      },
      "Snapshot": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Document",
            "type": "object"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "document"
        ],
        "title": "Snapshot",
        "type": "object"
      },
      "StageManifest": {
        "additionalProperties": false,
        "properties": {
          "adapter_version": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Adapter Version",
            "type": "string"
          },
          "created_at_ms": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "title": "Created At Ms",
            "type": "integer"
          },
          "effective_settings": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Effective Settings",
            "type": "object"
          },
          "execution_id": {
            "format": "uuid",
            "title": "Execution Id",
            "type": "string"
          },
          "input_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Input Hash",
            "type": "string"
          },
          "output_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Output Hash",
            "type": "string"
          },
          "parent_hashes": {
            "items": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "maxItems": 1000,
            "title": "Parent Hashes",
            "type": "array"
          },
          "producer_version": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Producer Version",
            "type": "string"
          },
          "reused_from": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reused From"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "stage_type": {
            "enum": [
              "preflight",
              "allocation",
              "aggregation",
              "clustering",
              "travel",
              "problem",
              "solve",
              "validation",
              "summary"
            ],
            "title": "Stage Type",
            "type": "string"
          }
        },
        "required": [
          "stage_type",
          "input_hash",
          "output_hash",
          "producer_version",
          "adapter_version",
          "parent_hashes",
          "effective_settings",
          "created_at_ms",
          "execution_id"
        ],
        "title": "StageManifest",
        "type": "object"
      },
      "Units": {
        "properties": {
          "distance": {
            "default": "meters (integer)",
            "title": "Distance",
            "type": "string"
          },
          "linear_feet": {
            "default": "hundredths of a foot (integer)",
            "title": "Linear Feet",
            "type": "string"
          },
          "money": {
            "default": "cents (integer)",
            "title": "Money",
            "type": "string"
          }
        },
        "title": "Units",
        "type": "object"
      },
      "WorkerEvent": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "progress",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "Kind",
            "type": "string"
          },
          "lease": {
            "$ref": "#/components/schemas/Lease"
          },
          "payload": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Payload",
            "type": "object"
          },
          "sequence": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          }
        },
        "required": [
          "lease",
          "sequence",
          "kind",
          "payload"
        ],
        "title": "WorkerEvent",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Fillrate optimizer",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/capabilities": {
      "get": {
        "operationId": "get_capabilities_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Capabilities"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
