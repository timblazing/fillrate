# All optional. Copy to deploy/.env.

# BIND_ADDR=127.0.0.1          # compose host binding; the default keeps the app on loopback
# OPTIMIZER_URL defaults to http://127.0.0.1:${OPTIMIZER_PORT:-8000}; never expose it publicly.

# WORKER_TOKEN=                # generated at container start when unset
# LEASE_MS=60000               # keep well above WORKER_HEARTBEAT_SECONDS (default 10), or every lease expires
# MAX_ORDERS=5000
# MAX_ORDER_LINES=25000
# MAX_VISITS=10000
# RUN_WALL_LIMIT_SECONDS=600

# Valhalla road matrices (optional). Run a Valhalla service yourself, then paste the output of `deploy/valhalla/prepare.sh env` here. All five
# are required for the "Build road matrix (Valhalla)" action and the travel_snapshot worker job; if any
# is unset the server answers 409 valhalla_not_configured and the browser shows the action as unavailable.
# VALHALLA_URL=http://valhalla:8002
# VALHALLA_VERSION=
# VALHALLA_GRAPH_CONFIG_HASH=
# VALHALLA_COSTING_OPTIONS='{}'
# VALHALLA_COSTING_LABEL=      # optional display label for the costing
# Optional limits (must match the deployment): VALHALLA_BLOCK_SIZE, VALHALLA_MAX_MATRIX_PAIRS,
# VALHALLA_MAX_MATRIX_LOCATIONS, VALHALLA_MAX_MATRIX_DISTANCE_M, VALHALLA_MAX_ROUTE_LOCATIONS
