# All optional. Copy to deploy/.env.

# BIND_ADDR=127.0.0.1          # compose host binding; the default keeps the app on loopback
# FILLRATE_OPTIMIZER_URL defaults to http://127.0.0.1:8000 (the optimizer binds to OPTIMIZER_PORT, default 8000); never expose it publicly.

# MAX_ORDERS=5000
# MAX_ORDER_LINES=25000
# MAX_VISITS=10000
# RUN_WALL_LIMIT_SECONDS=600

# Optional road path display: the browser calls the public Valhalla server for a selected shipment. Override the endpoint at build time:
# NEXT_PUBLIC_VALHALLA_URL=https://valhalla1.openstreetmap.de/route
