# All optional (spec §14).
# RUN_KEY=            # required to start/cancel runs in production; send as x-run-key or ?key=
# REVIEW_KEY=         # required for /dev/review saves in production
# WORKER_TOKEN=       # generated at container start when unset
# LEASE_MS=60000
# MAX_ORDERS=5000
# MAX_ORDER_LINES=25000
# MAX_VISITS=10000
# RUN_WALL_LIMIT_SECONDS=600
