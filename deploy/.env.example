# All optional unless noted (spec §14). Copy to deploy/.env.

# Deployment mode. Leave unset for the operator deployment (RUN_KEY / SCENARIO_KEY below).
#   local   one account-free dataset; no keys or credentials. Keep BIND_ADDR on loopback.
#   hosted  free accounts with GitHub sign-in. Every BETTER_AUTH_* / GITHUB_* line below is then required;
#           the container refuses to start (exit 78) if one is missing or invalid.
# FILLRATE_MODE=
# BIND_ADDR=127.0.0.1          # compose host binding; the default keeps the app on loopback

# Hosted mode (FILLRATE_MODE=hosted)
# BETTER_AUTH_SECRET=          # at least 32 characters: openssl rand -base64 32
# BETTER_AUTH_URL=             # canonical HTTPS origin, e.g. https://fillrate.blasingame.dev
# GITHUB_CLIENT_ID=            # GitHub OAuth app; callback URL <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_SECRET=
# TRUSTED_CLIENT_IP_HEADER=    # only if the app is reachable solely through a proxy that overwrites it (e.g. x-forwarded-for from Caddy)
# Account limits (starting values; tune against target-hardware evidence before opening signup)
# QUOTA_ACTIVE_JOBS=1  QUOTA_SOLVES_PER_DAY=20  QUOTA_IP_SOLVES_PER_DAY=60  QUOTA_GEOCODE_JOBS_PER_DAY=10
# QUOTA_ADDRESS_LOOKUPS_PER_DAY=200  QUOTA_SAVES_PER_DAY=100  QUOTA_UPLOADS_PER_DAY=20  MAX_UPLOAD_BYTES=10485760
# MAX_QUEUED_RUNS=10           # global; 50 outside hosted mode
# MAX_SWEEP_RUNS=10            # 25 outside hosted mode

# Operator keys (unset mode; in hosted mode SCENARIO_KEY still reaches the operator's own dataset)
# RUN_KEY=                     # start/cancel synthetic runs in production; send as x-run-key or ?key=
# SCENARIO_KEY=                # operator-owned imported scenarios; send as x-scenario-key
# PUBLIC_SYNTHETIC_RUNS=1      # anonymous example runs against PUBLIC_RUNS_PER_HOUR / PUBLIC_RUNS_PER_DAY

# WORKER_TOKEN=                # generated at container start when unset
# LEASE_MS=60000               # keep well above WORKER_HEARTBEAT_SECONDS (default 10), or every lease expires
# MAX_ORDERS=5000
# MAX_ORDER_LINES=25000
# MAX_VISITS=10000
# RUN_WALL_LIMIT_SECONDS=600
